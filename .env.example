# ---------------------------------------------------------------------------
# PaperFlow 环境变量示例。复制成 .env 后按需填写。
# 注意：**周循环必须有 AI**。没配 LLM_API_KEY 时 `week` 直接报错退出（退出码 1），
# 而且不写任何文件——宁可下周重跑，也不拿一份「按分数排个序」的假推荐污染你的状态。
# ---------------------------------------------------------------------------

# --- 你的 Obsidian 库 ---------------------------------------------------------
# 写上以后，init 就不用每次带 --vault 了。
PAPERFLOW_VAULT=D:\Obsidian\MyVault

# 状态目录。默认 <仓库>/paperflow_state；建议放进 vault，跟着笔记一起备份：
# PAPERFLOW_STATE_DIR=D:\Obsidian\MyVault\PaperFlow
PAPERFLOW_STATE_DIR=

# 输出语言：zh（默认）/ en
PAPERFLOW_LANG=zh

# --- AI（周循环必需）---------------------------------------------------------
# 任何 OpenAI 兼容的 chat-completions 端点都行。
# 留空 = 没有模型 = `week` 报错退出（`summary` 例外：它只出数字）。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- 引用门槛 ----------------------------------------------------------------
# PaperFlow 只把「引用量够高」的论文送进候选池，门槛随论文年龄放宽：
#   发表满 5 年 >= 50 次引用；2-4 年 >= 20 次；近两年 >= 5 次。
# 基准值默认 50，存在 config.json 的 "citation_base" 里；临时改就在命令行上给：
#   paperflow.py week --min-citations 100   # 更严
#   paperflow.py week --min-citations 0     # 关掉门槛（不推荐）

# --- 文献检索 ----------------------------------------------------------------
# Semantic Scholar 匿名可用，量大了再配 key；不配会自动回落到 OpenAlex。
S2_API_KEY=

# 可选。填了会进 OpenAlex / NCBI 的 "polite pool"，限流更宽松。
CONTACT_EMAIL=

# 可选。只影响 PubMed 的限流（3 req/s -> 10 req/s）。
NCBI_API_KEY=

# --- Zotero（只写不读）--------------------------------------------------------
# PaperFlow 只会往 Zotero **新建**条目（带「第n周」标签），从不读取你的库，
# 所以「哪篇推过」由 PaperFlow 自己的 进度.csv 负责去重，不需要 Zotero 读权限。
#
# 方式 A：本机 Zotero 连接器（推荐，零配置，但推送时 Zotero 必须开着）
#   走的是 Zotero 桌面端给浏览器插件用的本地接口，不用申请 key，也不用填 user id。
#   在 Zotero 9.0.6 上实测：条目字段和方式 B **一样全**（标题/作者/期刊/DOI/链接/摘要，
#   以及 extra 里的 Role / Rank / Paper ID）+ 「第n周」标签，并且会顺手把 PDF 全文挂上去。
#   三个限制：
#     · 条目落在你当时**选中的那个分类**里，PaperFlow 决定不了（它会把实际分类名打出来）；
#     · 推送时 Zotero 必须是开着的（没开就整个跳过，清单和周报照出）；
#     · PDF 只能抓开放获取的：先试结果里的 open_pdf，再试 arXiv 拼链，
#       还不行就让 Zotero 自己找一次；最终拿不到就只建条目，并报出「有几条没有 PDF」。
# ZOTERO_LOCAL=1
#
#   换地址（少见）：
# ZOTERO_CONNECTOR_URL=http://localhost:23119/connector
#
# 方式 B：网页版 API（需要 id + key）
#   唯一能指定目标分类、也是唯一在 Zotero 关闭时仍可用的路径。
#   注意：这条路**不挂 PDF**（只有标题/作者/期刊/DOI/链接/摘要/extra + 标签）——
#   想要全文就再手动拖一次，或者用方式 A。
ZOTERO_USER_ID=
ZOTERO_API_KEY=
# 覆盖默认的 https://api.zotero.org（优先级最高，但不会因此免除凭据）
# ZOTERO_API_URL=
#
# 注意：Zotero 9.0.6 的 /api/local/... **是只读的** —— 21 个端点全只接受 GET，
# POST 回 400 Endpoint does not support method；而且默认就是**关闭**的
# （直接请求回 403 Local API is not enabled，要去设置里手动打开）。
# 别把那个和方式 A 搞混：方式 A 用的是连接器接口，不需要打开任何开关。
